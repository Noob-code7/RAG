# Docent API configuration — copy to .env and fill in real values.

# Supabase project credentials (project settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Direct Postgres connection string (project settings -> Database -> Connection string)
# Needed because pgvector vectors are written/read with raw SQL via `pg`, not PostgREST.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Set to "false" if connecting to a local Postgres without SSL
DATABASE_SSL=true

# Embeddings provider — Google Gemini by default (native REST, no SDK).
# Set EMBEDDING_API_KEY or the single shared GEMINI_API_KEY below.
# For OpenAI: EMBEDDING_PROVIDER=openai, EMBEDDING_BASE_URL=https://api.openai.com/v1,
#             EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIMENSIONS=1536.
# Gemini embedding models (gemini-embedding-001) have flexible output
# dimensionality; EMBEDDING_DIMENSIONS must match the DB schema vector() width.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
GEMINI_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Ingestion tuning
CHUNK_TOKENS=500
OVERLAP_TOKENS=50
MAX_FILE_SIZE_MB=25
STORAGE_BUCKET=documents

# Retrieval (Phase 2)
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4
# Cosine-similarity confidence bands (tune per embedding model — see config.ts)
EMBED_SIM_THRESHOLD_HIGH=0.4
EMBED_SIM_THRESHOLD_LOW=0.25

# Generation model — Google Gemini by default (native generateContent REST).
# For OpenAI: GENERATION_PROVIDER=openai, GENERATION_MODEL=gpt-4o-mini,
#             GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-3.6-flash
GENERATION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GENERATION_API_KEY=

# Cost visibility (Phase 6) — list prices per 1M tokens used to log estimated
# spend per ingestion and per query in development. Override for your plan.
# Defaults are OpenAI list prices for the default models above.
EMBEDDING_PRICE_PER_MT=0.02
GENERATION_INPUT_PRICE_PER_MT=0.15
GENERATION_OUTPUT_PRICE_PER_MT=0.60

PORT=3001
